{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gus",
  "version": "0.4.0",
  "identifier": "com.gus.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "gus",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' data: blob: ipc: http://ipc.localhost https://api.github.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEREMTVGRTdBQjdDRjAxMjAKUldRZ0FjKzNldjRWM1M3RWRld0VtbFhMalNqblVHb0tZTmZjUTEvdkw5TGNIOFQxUnpsQ0N6RHkK",
      "endpoints": [
        "https://github.com/victorrubilar-dev/gus/releases/latest/download/latest.json"
      ]
    }
  }
}
